# app.config.js loads this file through dotenv. Copy it to `.env` and replace
# the address with the computer's current Wi-Fi IPv4 address for a physical
# phone. No SUPABASE_* vars: the app never talks to
# Supabase directly (architecture.md §2) — even MFA is proxied through the
# backend (backend/src/services/auth.service.js's clientForUser).
API_BASE_URL=http://localhost:4000/api/v1
