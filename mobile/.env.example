# Read directly from the shell environment by app.config.js — there's no
# dotenv loader here, so `export`/prefix it rather than expecting this file
# to be picked up automatically. No SUPABASE_* vars: the app never talks to
# Supabase directly (architecture.md §2) — even MFA is proxied through the
# backend (backend/src/services/auth.service.js's clientForUser).
API_BASE_URL=http://localhost:4000/api/v1
