# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # BACKEND ONLY — never ship to the mobile bundle
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- Postgres (Supabase pooler / PgBouncer) ----
DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# ---- Security ----
CORS_ORIGINS=http://localhost:19006   # comma-separated allow-list, no '*'
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READ=120
RATE_LIMIT_MAX_WRITE=30
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_PROVISION=5

# ---- Auth hardening ----
# MFA (DG/RD) enforcement — leave false until the mobile MFA-enrollment screen
# exists, or every DG/RD gets locked out with no way to complete enrollment.
MFA_ENFORCEMENT_ENABLED=false
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
INVITE_REDIRECT_URL=mec://auth/accept-invite
PASSWORD_RESET_REDIRECT_URL=mec://auth/reset-password

# ---- Observability ----
SENTRY_DSN=

# ---- Storage ----
STORAGE_BUCKET_VISIT_PHOTOS=visit-photos
STORAGE_BUCKET_ISSUE_PHOTOS=issue-photos
SIGNED_URL_TTL_SECONDS=300
