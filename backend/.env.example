# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://root:changeme@localhost:27017/smart_me_ecosystem?authSource=admin
# Optional MongoDB Atlas URI. Keep credentials only in backend/.env.
MONGO_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.dsbtwex.mongodb.net/smart_me_ecosystem

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sme-evidence

# Auth
JWT_SECRET=changeme
JWT_EXPIRES_IN=1d

# Variance Engine (proposed defaults, pending organizational confirmation)
GEOFENCE_RADIUS_METERS=50
VARIANCE_YELLOW_THRESHOLD=11
VARIANCE_RED_THRESHOLD=25
