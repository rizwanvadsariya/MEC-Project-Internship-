# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # BACKEND ONLY — never ship to the mobile bundle
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Postgres (Supabase pooler / PgBouncer) ----
DATABASE_URL=postgresql://postgres:<pwd>@<host>:6543/postgres?pgbouncer=true

# ---- Security ----
CORS_ORIGINS=http://localhost:19006   # comma-separated allow-list, no '*'
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READ=120
RATE_LIMIT_MAX_WRITE=30
RATE_LIMIT_MAX_AUTH=10

# ---- Observability ----
SENTRY_DSN=

# ---- Storage ----
STORAGE_BUCKET_VISIT_PHOTOS=visit-photos
STORAGE_BUCKET_ISSUE_PHOTOS=issue-photos
SIGNED_URL_TTL_SECONDS=300
